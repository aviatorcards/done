#extend("base"):
    #export("body"):
        <div class="relative overflow-hidden">
            <!-- Hero Section -->
            <div class="container mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center min-h-[85vh]">
                <div class="flex flex-col items-center lg:items-start text-center lg:text-left space-y-8 animate-in fade-in slide-in-from-left duration-1000">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 text-sm font-black tracking-wider uppercase">
                        <span class="flex h-2 w-2 rounded-full bg-emerald-600 animate-pulse"></span>
                        DMS Integration Ready
                    </div>
                    <h1 class="text-6xl lg:text-[76px] font-black text-slate-800 dark:text-white tracking-tighter leading-[0.95]">
                        Shop Dispatch & <br/>
                        <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-500 to-red-600">Service Flows,</span> <br/>
                        simplified.
                    </h1>
                    <p class="text-xl text-slate-500 dark:text-slate-400 max-w-lg leading-relaxed">
                        A real-time Kanban dispatcher designed specifically for auto service centers. Seamlessly bridge your DMS and shop scheduling systems.
                    </p>
                    <div class="flex flex-wrap justify-center lg:justify-start gap-4 pt-4">
                        <template x-if="!isLoggedIn">
                            <div class="flex flex-wrap gap-4">
                                <a href="/register" class="px-8 py-4 bg-brand-600 hover:bg-brand-700 text-white rounded-[2rem] font-black text-lg transition-all shadow-xl hover:shadow-2xl hover:-translate-y-1 active:scale-95 text-center">
                                    Register Shop
                                </a>
                                <a href="/login" class="px-8 py-4 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 dark:bg-obsidian-800/80 dark:text-indigo-300 border-2 border-indigo-200 dark:border-indigo-500/30 rounded-[2rem] font-black text-lg transition-all text-center flex items-center justify-center gap-2 group/btn shadow-sm hover:shadow-md">
                                    Sign In
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                    </svg>
                                </a>
                            </div>
                        </template>
                        <template x-if="isLoggedIn">
                            <a href="/boards" class="px-10 py-5 bg-gradient-to-r from-brand-500 to-red-600 hover:from-brand-600 hover:to-red-700 text-white rounded-[2rem] font-black text-xl transition-all shadow-2xl hover:shadow-brand-500/20 hover:-translate-y-1 active:scale-95 text-center flex items-center gap-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                                </svg>
                                Go to Shop Dispatch
                            </a>
                        </template>
                    </div>
                </div>
                
                <div class="relative hidden lg:block animate-in fade-in slide-in-from-right duration-1000">
                    <div class="absolute -inset-10 bg-gradient-to-br from-brand-500 to-red-600 rounded-[3rem] blur-3xl opacity-20 dark:opacity-30 animate-pulse"></div>
                    <div class="relative glass rounded-[3.5rem] overflow-hidden shadow-2xl border border-white/20">
                        <img src="/images/hero.jpg" alt="Done. Auto Shop Dispatch Dashboard" class="w-full h-auto transform hover:scale-105 transition-transform duration-[2000ms] ease-out">
                    </div>
                </div>
            </div>

            <!-- Features Grid -->
            <div id="features" class="container mx-auto px-6 py-32">
                <div class="text-center space-y-4 mb-20 animate-in fade-in slide-in-from-bottom duration-1000">
                    <h2 class="text-4xl lg:text-5xl font-black text-slate-800 dark:text-white tracking-tight">Built for modern service bays.</h2>
                    <p class="text-slate-500 dark:text-slate-400 text-lg max-w-2xl mx-auto">Focus on vehicle turnaround times with a visual dispatch layout designed to map to your existing DMS systems.</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Feature 1 -->
                    <div class="glass p-10 rounded-[3rem] border border-white/10 hover:border-brand-500/50 transition-all group hover:shadow-2xl hover:-translate-y-2">
                        <div class="h-16 w-16 rounded-2xl bg-brand-100 dark:bg-brand-900/40 flex items-center justify-center text-brand-600 mb-8 group-hover:scale-110 group-hover:rotate-3 transition-transform">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-black text-slate-800 dark:text-white mb-4">DMS & Scheduler Sync</h3>
                        <p class="text-slate-500 dark:text-slate-400 leading-relaxed">
                            Bridge your front office and workshop floor. Pull service appointments, customer write-ups, and repair recommendations instantly from your core systems.
                        </p>
                    </div>
                    
                    <!-- Feature 2 -->
                    <div class="glass p-10 rounded-[3rem] border border-white/10 hover:border-brand-500/50 transition-all group hover:shadow-2xl hover:-translate-y-2">
                        <div class="h-16 w-16 rounded-2xl bg-indigo-100 dark:bg-indigo-900/40 flex items-center justify-center text-indigo-600 mb-8 group-hover:scale-110 group-hover:-rotate-3 transition-transform">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m9 0h4M9 21h-1m2 0V11a2 2 0 00-2-2H5a2 2 0 00-2 2v10m6 0V9a2 2 0 012-2h4a2 2 0 012 2v12m-6 0h-2" />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-black text-slate-800 dark:text-white mb-4">Bay Allocation</h3>
                        <p class="text-slate-500 dark:text-slate-400 leading-relaxed">
                            Drag and drop vehicles to assign them to physical bays (Bay 1–8) or specific technician IDs in real-time, matching shop load immediately.
                        </p>
                    </div>
                    
                    <!-- Feature 3 -->
                    <div class="glass p-10 rounded-[3rem] border border-white/10 hover:border-brand-500/50 transition-all group hover:shadow-2xl hover:-translate-y-2">
                        <div class="h-16 w-16 rounded-2xl bg-purple-100 dark:bg-purple-900/40 flex items-center justify-center text-purple-600 mb-8 group-hover:scale-110 group-hover:rotate-3 transition-transform">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m-5-2a2 2 0 012 2m-5-2a2 2 0 012 2m-5-2a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2V9a2 2 0 00-2-2M2 9h18" />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-black text-slate-800 dark:text-white mb-4">Key & Lot Tracking</h3>
                        <p class="text-slate-500 dark:text-slate-400 leading-relaxed">
                            Locate keys and vehicles in the lot instantly. Lot Key Tag numbers and promised completion times are parsed and displayed directly on the card face.
                        </p>
                    </div>

                    <!-- Feature 4 -->
                    <div class="glass p-10 rounded-[3rem] border border-white/10 hover:border-brand-500/50 transition-all group hover:shadow-2xl hover:-translate-y-2">
                        <div class="h-16 w-16 rounded-2xl bg-rose-100 dark:bg-rose-900/40 flex items-center justify-center text-rose-600 mb-8 group-hover:scale-110 group-hover:-rotate-3 transition-transform">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-black text-slate-800 dark:text-white mb-4">Parts Hold Alerts</h3>
                        <p class="text-slate-500 dark:text-slate-400 leading-relaxed">
                            Identify and flag vehicles waiting on parts with distinct visual indicators to prevent shop bottlenecks and keep advisors up to date on delays.
                        </p>
                    </div>

                    <!-- Feature 5 -->
                    <div class="glass p-10 rounded-[3rem] border border-white/10 hover:border-brand-500/50 transition-all group hover:shadow-2xl hover:-translate-y-2">
                        <div class="h-16 w-16 rounded-2xl bg-amber-100 dark:bg-amber-900/40 flex items-center justify-center text-amber-600 mb-8 group-hover:scale-110 group-hover:rotate-3 transition-transform">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-black text-slate-800 dark:text-white mb-4">Customer Approval Flows</h3>
                        <p class="text-slate-500 dark:text-slate-400 leading-relaxed">
                            Track estimates sent and customer authorizations directly in your main shop dispatch flow.
                        </p>
                    </div>

                    <!-- Feature 6 -->
                    <div class="glass p-10 rounded-[3rem] border border-white/10 hover:border-brand-500/50 transition-all group hover:shadow-2xl hover:-translate-y-2">
                        <div class="h-16 w-16 rounded-2xl bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center text-emerald-600 mb-8 group-hover:scale-110 group-hover:-rotate-3 transition-transform">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-black text-slate-800 dark:text-white mb-4">Shop Monitor Layout</h3>
                        <p class="text-slate-500 dark:text-slate-400 leading-relaxed">
                            A stunning glassmorphism design with a dark carbon look. Tailored specifically to look incredible on service advisor terminals and large shop display TVs.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Future Roadmap -->
            <div id="roadmap" class="bg-indigo-600/5 dark:bg-obsidian-900/30 py-40 border-y border-slate-200/50 dark:border-white/5">
                <div class="container mx-auto px-6">
                    <div class="max-w-4xl mx-auto glass p-12 md:p-20 rounded-[4rem] border border-brand-500/20 shadow-2xl relative overflow-hidden">
                        <div class="absolute -top-24 -right-24 w-64 h-64 bg-brand-500/20 blur-3xl rounded-full"></div>
                        <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-indigo-500/20 blur-3xl rounded-full"></div>
                        
                        <div class="text-center mb-16 relative">
                            <h2 class="text-4xl lg:text-5xl font-black text-slate-800 dark:text-white mb-4 tracking-tight">The Vision.</h2>
                            <p class="text-slate-500 dark:text-slate-400 text-lg">We are expanding our shop tools. Here is what we are building next.</p>
                        </div>
                        
                        <div class="space-y-6 relative">
                            <div class="flex flex-col md:flex-row items-center md:items-start gap-6 p-8 rounded-[2.5rem] bg-white/50 dark:bg-obsidian-800/50 border border-slate-100 dark:border-obsidian-700 transition-all hover:scale-[1.02] text-center md:text-left">
                                <div class="h-14 w-14 rounded-2xl bg-brand-100 dark:bg-brand-900/30 flex items-center justify-center text-brand-600 flex-shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                                    </svg>
                                </div>
                                <div class="flex-1">
                                    <h4 class="text-lg font-black text-slate-800 dark:text-white">Parts Store Integration</h4>
                                    <p class="text text-slate-500 dark:text-slate-400">Quick-ordering from parts catalog syndications. Check parts availability directly on the job cards.</p>
                                </div>
                                <span class="hidden md:block text-[10px] font-black uppercase tracking-[0.2em] text-brand-600 bg-brand-100 dark:bg-brand-900/30 px-3 py-1.5 rounded-full whitespace-nowrap">Up Next</span>
                             </div>
                            
                            <div class="flex flex-col md:flex-row items-center md:items-start gap-6 p-8 rounded-[2.5rem] bg-white/50 dark:bg-obsidian-800/50 border border-slate-100 dark:border-obsidian-700 transition-all hover:scale-[1.02] text-center md:text-left">
                                <div class="h-14 w-14 rounded-2xl bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center text-orange-600 flex-shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2m0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h-2a2 2 0 00-2-2z" />
                                    </svg>
                                </div>
                                <div class="flex-1">
                                    <h4 class="text-lg font-black text-slate-800 dark:text-white">Bay Utilization Analytics</h4>
                                    <p class="text text-slate-500 dark:text-slate-400">Track technician repair efficiencies, average turnaround time per bay, and daily shop metrics.</p>
                                </div>
                                <span class="hidden md:block text-[10px] font-black uppercase tracking-[0.2em] text-orange-600 bg-orange-100 dark:bg-orange-900/30 px-3 py-1.5 rounded-full whitespace-nowrap">Planned</span>
                            </div>

                            <div class="flex flex-col md:flex-row items-center md:items-start gap-6 p-8 rounded-[2.5rem] bg-white/50 dark:bg-obsidian-800/50 border border-slate-100 dark:border-obsidian-700 transition-all hover:scale-[1.02] text-center md:text-left">
                                <div class="h-14 w-14 rounded-2xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 flex-shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-.447.894L16 18.618v-8.618zM4 18.618h12M4 18.618v-8.618L8.553 7.724a1 1 0 01.894 0L14 10v8.618m-10 0a2 2 0 012 2h8a2 2 0 012-2" />
                                    </svg>
                                </div>
                                <div class="flex-1">
                                    <h4 class="text-lg font-black text-slate-800 dark:text-white">License Plate Recognition</h4>
                                    <p class="text text-slate-500 dark:text-slate-400">Camera integrations for service drive entrances to check-in arriving vehicles automatically.</p>
                                </div>
                                <span class="hidden md:block text-[10px] font-black uppercase tracking-[0.2em] text-blue-600 bg-blue-100 dark:bg-blue-900/30 px-3 py-1.5 rounded-full whitespace-nowrap">In Concept</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CTA Section -->
            <div class="container mx-auto px-6 py-48 text-center bg-white dark:bg-obsidian-950 relative overflow-hidden">
                <div class="relative z-10">
                    <h2 class="text-5xl lg:text-7xl font-black text-slate-800 dark:text-white mb-10 tracking-tighter">Ready to dispatch your shop?</h2>
                    <template x-if="!isLoggedIn">
                        <a href="/register" class="inline-block px-16 py-6 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-[2.5rem] font-black text-2xl hover:scale-110 transition-transform shadow-2xl active:scale-95">
                            Register Shop for Free
                        </a>
                    </template>
                    <template x-if="isLoggedIn">
                        <a href="/boards" class="inline-block px-16 py-6 bg-brand-600 text-white rounded-[2.5rem] font-black text-2xl hover:scale-110 transition-transform shadow-2xl active:scale-95">
                            Go to Shop Boards
                        </a>
                    </template>
                </div>
            </div>

            #extend("partials/footer")
        </div>
    #endexport
#endextend
