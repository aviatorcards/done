<div id="card-modal" 
     x-data="{ show: true }" 
     x-show="show" 
     class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-obsidian-950/60 backdrop-blur-md"
     x-transition:enter="transition ease-out duration-300"
     x-transition:enter-start="opacity-0"
     x-transition:enter-end="opacity-100"
     x-cloak>
    <div @click.away="show = false; setTimeout(() => document.getElementById('card-modal').remove(), 300)" 
         class="glass w-full max-w-lg p-8 rounded-[2.5rem] shadow-2xl space-y-6"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 scale-95 translate-y-4"
         x-transition:enter-end="opacity-100 scale-100 translate-y-0">
        
        <div class="flex justify-between items-center">
            <h2 class="text-2xl font-bold text-slate-800 dark:text-white">New Card</h2>
            <button @click="show = false; setTimeout(() => document.getElementById('card-modal').remove(), 300)" class="p-2 hover:bg-slate-100 dark:hover:bg-zinc-800 rounded-full transition-colors text-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <form hx-post="/cards" 
              hx-ext="json-enc"
              hx-target=".card-list[data-column-id='#(columnID)']"
              hx-swap="beforeend"
              hx-on::after-request="if(event.detail.successful) { document.getElementById('card-modal').remove(); window.updateColumnCount('#(columnID)'); }"
              class="space-y-6">
            <input type="hidden" name="column_id" value="#(columnID)">
            
            <div class="space-y-2">
                <label class="text-sm font-semibold text-slate-700 dark:text-zinc-300 ml-1">Card Title</label>
                <input type="text" name="title" required placeholder="What needs to be done?" 
                       class="w-full px-5 py-4 rounded-2xl bg-white dark:bg-zinc-800 border border-slate-200 dark:border-zinc-700 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all">
            </div>

            <div class="space-y-2" x-data="{ activeTab: 'write', descText: '' }">
                <div class="flex justify-between items-center ml-1">
                    <label class="text-sm font-semibold text-slate-700 dark:text-zinc-300">Description</label>
                    <div class="flex bg-slate-100 dark:bg-zinc-800/80 p-0.5 rounded-lg text-xs">
                        <button type="button" @click="activeTab = 'write'" 
                                :class="activeTab === 'write' ? 'bg-white dark:bg-zinc-700 text-brand-600 dark:text-white shadow-sm' : 'text-slate-500 dark:text-slate-400'"
                                class="px-3 py-1 rounded-md font-bold transition-all">Write</button>
                        <button type="button" @click="activeTab = 'preview'" 
                                :class="activeTab === 'preview' ? 'bg-white dark:bg-zinc-700 text-brand-600 dark:text-white shadow-sm' : 'text-slate-500 dark:text-slate-400'"
                                class="px-3 py-1 rounded-md font-bold transition-all">Preview</button>
                    </div>
                </div>
                
                <div x-show="activeTab === 'write'">
                    <textarea name="description" rows="4" x-model="descText" placeholder="Add some details using Markdown..." 
                              class="w-full px-5 py-4 rounded-2xl bg-white dark:bg-zinc-800 border border-slate-200 dark:border-zinc-700 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition-all resize-none font-medium text-slate-700 dark:text-slate-200"></textarea>
                </div>
                
                <div x-show="activeTab === 'preview'" class="w-full min-h-[112px] px-5 py-4 rounded-2xl bg-slate-50/50 dark:bg-zinc-900/45 border border-slate-200 dark:border-zinc-700/60 text-slate-700 dark:text-slate-350 markdown-body overflow-y-auto max-h-48"
                     x-html="descText.trim() ? marked.parse(descText) : '<span class=\'text-slate-400 dark:text-slate-500 italic\'>Nothing to preview</span>'">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="space-y-2">
                    <label class="text-sm font-semibold text-slate-700 dark:text-zinc-300 ml-1">Priority</label>
                    <select name="priority" class="w-full px-5 py-4 rounded-2xl bg-white dark:bg-zinc-800 border border-slate-200 dark:border-zinc-700 focus:border-brand-500 outline-none transition-all">
                        <option value="low">Low</option>
                        <option value="medium" selected>Medium</option>
                        <option value="high">High</option>
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-semibold text-slate-700 dark:text-zinc-300 ml-1">Due Date</label>
                    <input type="date" name="due_date" 
                           class="w-full px-5 py-4 rounded-2xl bg-white dark:bg-zinc-800 border border-slate-200 dark:border-zinc-700 focus:border-brand-500 outline-none transition-all">
                </div>
            </div>

            <div class="flex gap-3 pt-4">
                <button type="button" @click="show = false; setTimeout(() => document.getElementById('card-modal').remove(), 300)" 
                        class="flex-1 px-6 py-4 rounded-2xl font-bold text-slate-600 hover:bg-slate-100 transition-colors">
                    Cancel
                </button>
                <button type="submit"
                        class="flex-1 bg-brand-600 hover:bg-brand-700 text-white px-6 py-4 rounded-2xl font-bold transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5">
                    Create Card
                </button>
            </div>
        </form>
    </div>
</div>
